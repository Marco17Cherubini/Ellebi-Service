{
  "root": true,
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "multi-line"],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "caughtErrors": "none"
      }
    ]
  },
  "overrides": [
    {
      "files": ["server/**/*.js", "config/**/*.js", "ecosystem.config.js", "test/**/*.js"],
      "env": {
        "node": true,
        "es2022": true
      }
    },
    {
      "files": ["frontend/js/**/*.js"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "vars": "local",
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true,
            "caughtErrors": "none"
          }
        ],
        "no-redeclare": [
          "error",
          {
            "builtinGlobals": false
          }
        ]
      },
      "globals": {
        "module": "readonly",
        "apiRequest": "readonly",
        "escapeHTML": "readonly",
        "showError": "readonly",
        "showSuccess": "readonly",
        "hideMessage": "readonly",
        "formatDate": "readonly",
        "formatDateShort": "readonly",
        "getCurrentUser": "readonly",
        "redirectToLogin": "readonly",
        "redirectToDashboard": "readonly",
        "Modal": "readonly",
        "goToStep": "readonly",
        "Chart": "readonly",
        "makeKeyboardActivatable": "readonly",
        "setupSidebar": "readonly"
      }
    },
    {
      "files": ["client-src/**/*.js"],
      "parserOptions": {
        "sourceType": "module"
      },
      "env": {
        "browser": true,
        "es2022": true
      }
    },
    {
      "files": ["test/e2e/**/*.js"],
      "env": {
        "node": true,
        "browser": true,
        "es2022": true
      },
      "globals": {
        "selectedExtraWorkSlots": "readonly"
      }
    },
    {
      "files": ["client-src/render-stills.js"],
      "parserOptions": {
        "sourceType": "script"
      },
      "env": {
        "node": true,
        "browser": true,
        "es2022": true
      }
    }
  ],
  "ignorePatterns": ["client-src/build/"]
}
