{
  "name": "ellebi-service",
  "version": "1.0.0",
  "description": "Booking and workshop management web app for a car and motorcycle repair shop",
  "main": "server/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop lb-service",
    "restart": "pm2 restart lb-service",
    "logs": "pm2 logs lb-service",
    "status": "pm2 status",
    "backup": "node server/backup.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test \"test/**/*.test.js\"",
    "format:check": "prettier --check .",
    "seed": "node server/seed.js",
    "build:3d": "esbuild client-src/garage3d.js --bundle --format=esm --minify --legal-comments=eof --target=es2020 --outfile=frontend/js/garage3d.js",
    "test:e2e": "node --test \"test/e2e/*.e2e.js\""
  },
  "keywords": [
    "workshop",
    "garage",
    "booking",
    "scheduling",
    "express",
    "sqlite"
  ],
  "author": "Marco Cherubini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Marco17Cherubini/Ellebi-Service.git"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.9",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^6.6.0",
    "sql.js": "^1.13.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  }
}
