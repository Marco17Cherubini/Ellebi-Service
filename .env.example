# ==================== SERVER ====================
PORT=3000
# development in locale; production abilita cookie "secure" (richiede HTTPS), trust proxy
# e la retention automatica dei dati
NODE_ENV=development
# URL pubblico usato nei link delle email (es. reset password)
BASE_URL=http://localhost:3000
# Facoltativo: fuso orario di slot e prenotazioni (default Europe/Rome)
# TZ=Europe/Rome

# ==================== SICUREZZA ====================
# Obbligatorio. Stringa casuale di almeno 32 caratteri, generala con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Il server non parte se il valore è assente o è questo segnaposto.
JWT_SECRET=CAMBIA_QUESTO_CON_UNA_STRINGA_CASUALE_DI_ALMENO_64_CARATTERI

# Account amministratore, creato al primo avvio solo se la tabella admins è vuota
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaMi_ConPassword_Sicura_123!

# Facoltativo: richieste per IP ogni 15 minuti (default 10 per login/registrazione/reset,
# 5 per le prenotazioni ospite)
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_GUEST_MAX=5

# ==================== DATABASE ====================
# Facoltativo: percorso del file SQLite (default: database/database.sqlite).
# Su Railway, ad esempio, /data/database.sqlite con un Volume montato su /data
# DATABASE_PATH=
# Facoltativo: cartella dei backup di `npm run backup` (default: backups/)
# BACKUP_DIR=

# Facoltativo: cancellazione automatica dei dati scaduti (server/retentionService.js).
# Default: attiva solo con NODE_ENV=production
# RETENTION_ENABLED=false

# ==================== EMAIL (Resend) ====================
# Facoltativo: senza chiave le email vengono saltate con un avviso in console
RESEND_API_KEY=
EMAIL_FROM=Ellebi Service <onboarding@resend.dev>

# ==================== OFFICINA ====================
# Facoltativo: dati mostrati nelle email (default in config/config.js)
# STUDIO_NAME=Ellebi Service SRL
# STUDIO_PHONE=+39 000 000 0000
# STUDIO_ADDRESS=Via Example 1, 00100 Città, Italia
